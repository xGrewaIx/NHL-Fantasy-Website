# Python
# Storing compiled bytecode
__pycache__/ 
# Compiled python binaries 
*.py[cod]
# optimized bytecode files 
*.pyo

# Virtual environment
# Both these files contain entire python installation and
# download external packages
.venv/
venv/

# Testing
# created by pytest to remember previous tests failures and speed up following test runs
.pytest_cache/
# data file generated by test coverage tools tracking whcih lines of code were executed
.coverage
# Folder containing generated HTML reports showing pretty graphs of test coverage
htmlcov/

# Ruff
# Cache directory for ruff to make code checks fasters
.ruff_cache/

# Environment variables
# Stores all important information we do not want to commit to the repo (API keys, databse passwords etc)
.env
# Ensures no other environemnt files with something trailing is committed
.env.*
# Do not ignore the blank template for my env file so views can see what variables they need to set up locally
!.env.example

# IDEs
# Personal VS code layout/extensions are stored in this file
.vscode/
# Personal settings folder created by pycharm etc
.idea/

# OS
# Hidden system file created by macOS finder app. Saves how I look at a folder
.DS_Store
# Hiden database file created by microsoft windows
Thumbs.db

# Local data
# Git cannot handle large data volumes effectively
data/bronze/*
data/silver/*
data/gold/*
# Local storage for local databases or datawarehouse mockups
data/warehouse/*

# Generated artifacts
# Stores final models, exported charts, etc. 
artifacts/*

# Logs
# Holds an automated chronological text record of events, actions, erros, and system mesasges 
# generated by an operating system. 
*.log
# directory holding application runtime logs
logs/


# ignore all example api responses in test (folder = tests/example_API_responses)
tests/example_API_responses/*